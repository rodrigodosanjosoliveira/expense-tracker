# Configurações do Servidor
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Configurações do Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=expensetracker
DB_PASSWORD=secret
DB_NAME=expenses
DB_SSLMODE=disable

# JWT Secret (obrigatório - altere para um valor seguro)
JWT_SECRET=change-me-to-a-secure-secret

# Ambiente (development, production)
ENV=development
